{
  "name": "@nayacura/backend",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "ai:import": "tsx src/scripts/importAiSource.ts",
    "db:generate": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:push": "prisma db push --schema prisma/schema.postgresql.prisma",
    "db:seed": "tsx prisma/local-seed.ts",
    "db:reset": "node -e \"throw new Error('Automatic database reset is disabled.')\"",
    "db:migrate": "prisma migrate dev --schema prisma/schema.postgresql.prisma",
    "test": "npm run db:seed && vitest run --pool=forks --maxWorkers=1",
    "db:deploy": "prisma migrate deploy --schema prisma/postgresql/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/local-seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "argon2": "^0.45.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "livekit-server-sdk": "^2.9.0",
    "luxon": "^3.5.0",
    "nodemailer": "^10.6.1",
    "otpauth": "^9.6.0",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "razorpay": "^2.9.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "^19.0.0-beta.20",
    "prisma": "6.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
